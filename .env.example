# Copie para .env e ajuste. Todos os valores têm padrão no docker-compose.yml.

# Hostname e path do OCSP responder. Usados pelo servidor (Host e endpoint esperados)
# e na emissão: os certificados de cliente recebem AIA OCSP = http://<OCSP_HOSTNAME><OCSP_PATH>
OCSP_HOSTNAME=ocsp.rdigaum.com.br
# POST em <OCSP_PATH>, GET em <OCSP_PATH>/<base64>. Use "/" para a raiz.
OCSP_PATH=/ocsp/validation
# true = requisições OCSP com Host diferente de OCSP_HOSTNAME recebem "unauthorized"
# false = apenas registra host_mismatch no log
OCSP_STRICT_HOST=false
# Porta publicada no host
HTTP_PORT=80
# Janela thisUpdate→nextUpdate da resposta OCSP (também vira Cache-Control max-age).
# Valores baixos fazem revogar/desrevogar aparecer mais rápido em quem cacheia (ex.: Akamai).
OCSP_VALIDITY_SECONDS=300
LOG_LEVEL=INFO

# Identidade da PKI (usada só no init / issue)
PKI_ORG=RDigaum Test PKI
PKI_COUNTRY=BR
ROOT_CN=RDigaum Test Root CA
ICA_CN=RDigaum Test Issuing CA
OCSP_SIGNER_CN=RDigaum Test OCSP Responder
ROOT_DAYS=7300
ICA_DAYS=3650
OCSP_SIGNER_DAYS=730
CLIENT_DAYS=365
